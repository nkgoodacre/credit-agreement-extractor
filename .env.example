# Copy to .env and fill in. .env is git-ignored; never commit real values.

# SEC EDGAR requires a descriptive User-Agent with a real name and email
# (Phase 1). Format: "Your Name your@email.com"
SEC_USER_AGENT="Your Name your@email.com"

# Anthropic API key for the frontier models (Phase 5).
ANTHROPIC_API_KEY=""

# Base URL for a local Ollama server (Phase 5). Default shown.
OLLAMA_HOST="http://localhost:11434"
